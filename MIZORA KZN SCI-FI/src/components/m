'use client';

import React, { useState, useRef, useEffect } from 'react';
import { Layers, CheckCircle2, ArrowRight, ChevronRight, ChevronLeft, Zap, FileText, Users, Target } from 'lucide-react';
import { motion, AnimatePresence } from 'framer-motion';
import { Language, TranslationSet, ServiceItem } from '@/lib/mizora-types';
import ScrollReveal from './ScrollReveal';

interface ServicesSectionProps {
  t: TranslationSet;
  lang: Language;
}

// ─── Animation Variants ───

const summaryVariants = {
  initial: { opacity: 0, y: -15 },
  animate: {
    opacity: 1,
    y: 0,
    transition: { duration: 0.4, delay: 0.15, ease: [0.4, 0, 0.2, 1] },
  },
  exit: {
    opacity: 0,
    y: -15,
    transition: { duration: 0.2, ease: [0.4, 0, 0.2, 1] },
  },
};

const detailVariants = {
  initial: { opacity: 0, y: 20 },
  animate: {
    opacity: 1,
    y: 0,
    transition: { duration: 0.4, delay: 0.15, ease: [0.4, 0, 0.2, 1] },
  },
  exit: {
    opacity: 0,
    y: 20,
    transition: { duration: 0.2, ease: [0.4, 0, 0.2, 1] },
  },
};

const detailContainerVariants = {
  hidden: { opacity: 0 },
  visible: {
    opacity: 1,
    transition: { staggerChildren: 0.05, delayChildren: 0.2 },
  },
  exit: {
    opacity: 0,
    transition: { staggerChildren: 0.02, staggerDirection: -1 },
  },
};

const detailItemVariants = {
  hidden: { opacity: 0, y: 10 },
  visible: {
    opacity: 1,
    y: 0,
    transition: { duration: 0.3, ease: [0.4, 0, 0.2, 1] },
  },
  exit: {
    opacity: 0,
    y: 8,
    transition: { duration: 0.15 },
  },
};

// ─── Service Card Component (with in-card Detail Panel, same height) ───
function ServiceCard({
  service,
  index,
  lang,
  viewDetailText,
}: {
  service: ServiceItem;
  index: number;
  lang: Language;
  viewDetailText: string;
}) {
  const [showDetail, setShowDetail] = useState(false);
  const cardRef = useRef<HTMLDivElement>(null);
  const summaryRef = useRef<HTMLDivElement>(null);
  const [cardHeight, setCardHeight] = useState<number | undefined>(undefined);

  // Measure summary view height and lock it
  useEffect(() => {
    if (!showDetail && summaryRef.current) {
      const ro = new ResizeObserver(() => {
        setCardHeight(summaryRef.current?.offsetHeight);
      });
      ro.observe(summaryRef.current);
      setCardHeight(summaryRef.current.offsetHeight);
      return () => ro.disconnect();
    }
  }, [showDetail]);

  const handleViewDetail = () => {
    // Capture height before switching
    if (summaryRef.current) {
      setCardHeight(summaryRef.current.offsetHeight);
    }
    setShowDetail(true);
    setTimeout(() => {
      if (cardRef.current) {
        const rect = cardRef.current.getBoundingClientRect();
        const offsetTop = rect.top + window.pageYOffset - 80;
        window.scrollTo({ top: offsetTop, behavior: 'smooth' });
      }
    }, 400);
  };

  const handleBack = () => {
    setShowDetail(false);
    setTimeout(() => {
      if (cardRef.current) {
        const rect = cardRef.current.getBoundingClientRect();
        const offsetTop = rect.top + window.pageYOffset - 80;
        window.scrollTo({ top: offsetTop, behavior: 'smooth' });
      }
    }, 400);
  };

  return (
    <ScrollReveal yOffset={35} delay={index * 0.08} className="h-full">
      <div
        ref={cardRef}
        className={`bg-white rounded-sm flex flex-col relative group widget-3d transition-all duration-300 ${
          showDetail
            ? 'border-2 border-black/20 shadow-lg shadow-black/5'
            : 'border border-neutral-200 hover:border-black/30'
        }`}
        style={cardHeight && showDetail ? { minHeight: `${cardHeight}px`, maxHeight: `${cardHeight}px` } : undefined}
      >
        {/* Corner accents */}
        <div className="absolute top-0 right-0 h-4 w-[1px] bg-neutral-200 transition-all group-hover:bg-black/40" />
        <div className="absolute top-0 right-0 w-4 h-[1px] bg-neutral-200 transition-all group-hover:bg-black/40" />

        <AnimatePresence mode="wait">
          {!showDetail ? (
            /* ═══════════════════════════════════════════
               SUMMARY VIEW
            ═══════════════════════════════════════════ */
            <motion.div
              key="summary"
              ref={summaryRef}
              variants={summaryVariants}
              initial="initial"
              animate="animate"
              exit="exit"
              className="p-8 flex flex-col justify-between"
            >
              <div className="text-left w-full">
                {/* Header: Icon + Service ID */}
                <div className="flex items-center justify-between mb-6">
                  <div className="w-8 h-8 rounded-sm bg-neutral-100 flex items-center justify-center transition-transform group-hover:scale-105 duration-300 border border-neutral-200">
                    <Layers className="w-4 h-4 text-black" />
                  </div>
                  <span className="font-mono text-[9px] text-neutral-400 tracking-wider font-extrabold uppercase">
                    SERVICE // ID: {service.id.toUpperCase()}
                  </span>
                </div>

                {/* Title */}
                <h3 className="font-sans font-black text-xl md:text-2xl text-black tracking-tight uppercase mb-2">
                  {service.name}
                </h3>

                {/* Tagline */}
                <p className="font-mono text-[10px] text-neutral-400 tracking-widest uppercase font-bold mb-3">
                  {service.tagline}
                </p>

                {/* Description */}
                <p className="font-sans text-neutral-500 text-xs md:text-sm leading-relaxed mb-6">
                  {service.benefit}
                </p>

                {/* Scope + Features Grid */}
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-6 border-t border-neutral-100 mb-8 w-full">
                  <div>
                    <h4 className="font-mono text-[9px] text-neutral-400 tracking-widest uppercase mb-3 font-bold">
                      {lang === 'id' ? 'LINGKUP UTAMA' : 'DELIVERY SCOPE'}
                    </h4>
                    <ul className="flex flex-col gap-2">
                      {service.scope.map((item, idy) => (
                        <li key={idy} className="flex items-start gap-2 font-sans text-xs text-neutral-600">
                          <CheckCircle2 className="w-3.5 h-3.5 text-black shrink-0" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div>
                    <h4 className="font-mono text-[9px] text-neutral-400 tracking-widest uppercase mb-3 font-bold">
                      {lang === 'id' ? 'FITUR OPERASIONAL' : 'OPERATIONAL FEATURES'}
                    </h4>
                    <div className="flex flex-col gap-1.5">
                      {service.features.map((feature, idz) => (
                        <span key={idz} className="p-2 border border-neutral-200 bg-neutral-50 rounded-xs font-mono text-[9px] font-bold uppercase tracking-wider text-neutral-600 shadow-2xs">
                          {feature}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              {/* Footer: Target Outcome + CTA */}
              <div className="flex items-center justify-between pt-4 border-t border-neutral-100 mt-auto w-full">
                <div className="text-left">
                  <span className="font-mono text-[8px] text-neutral-400 uppercase tracking-widest block mb-0.5 font-bold">TARGET OUTCOME</span>
                  <span className="font-mono text-xs font-black text-black uppercase">{service.targetMetric}</span>
                </div>

                {/* CTA Button */}
                <button
                  onClick={handleViewDetail}
                  className="group/btn relative overflow-hidden p-2.5 px-5 bg-black border border-black hover:bg-neutral-800 text-white transition-all duration-300 text-[10px] font-extrabold rounded-sm flex items-center gap-2 uppercase tracking-widest active:scale-95 cursor-pointer shadow-sm"
                >
                  <span className="relative z-10">{viewDetailText}</span>
                  <ChevronRight className="w-3.5 h-3.5 relative z-10 transition-transform duration-300 group-hover/btn:translate-x-0.5" />
                </button>
              </div>
            </motion.div>
          ) : (
            /* ═══════════════════════════════════════════
               DETAIL VIEW (inside same card, same height, scrollable)
            ═══════════════════════════════════════════ */
            <motion.div
              key="detail"
              variants={detailVariants}
              initial="initial"
              animate="animate"
              exit="exit"
              className="flex flex-col h-full"
              style={cardHeight ? { minHeight: `${cardHeight}px`, maxHeight: `${cardHeight}px` } : undefined}
            >
              {/* Detail Header — Back button + Title */}
              <div className="flex items-center justify-between px-8 pt-6 pb-3 border-b border-neutral-100 shrink-0">
                <div className="flex items-center gap-3">
                  <div className="w-8 h-8 rounded-sm bg-neutral-100 flex items-center justify-center border border-neutral-200">
                    <Layers className="w-4 h-4 text-black" />
                  </div>
                  <div>
                    <h3 className="font-sans font-black text-sm md:text-base text-black tracking-tight uppercase">
                      {service.detail.title}
                    </h3>
                    <span className="font-mono text-[8px] text-neutral-400 tracking-widest uppercase font-bold">
                      {lang === 'id' ? 'DETAIL LAYANAN' : 'SERVICE DETAILS'}
                    </span>
                  </div>
                </div>
                <button
                  onClick={handleBack}
                  className="flex items-center gap-1.5 px-3 py-2 border border-neutral-200 hover:border-black/30 hover:bg-neutral-50 rounded-sm text-[10px] font-extrabold uppercase tracking-widest text-neutral-600 hover:text-black transition-all cursor-pointer shrink-0"
                >
                  <ChevronLeft className="w-3.5 h-3.5" />
                  <span>{lang === 'id' ? 'Kembali' : 'Back'}</span>
                </button>
              </div>

              {/* Detail Content — scrollable, constrained to card height */}
              <motion.div
                className="flex-1 overflow-y-auto px-8 py-5 min-h-0"
                variants={detailContainerVariants}
                initial="hidden"
                animate="visible"
                exit="exit"
                style={{ scrollbarWidth: 'thin' }}
              >
                {/* About */}
                <motion.div variants={detailItemVariants} className="mb-6">
                  <div className="flex items-center gap-2 mb-2">
                    <FileText className="w-3.5 h-3.5 text-neutral-500" />
                    <span className="font-mono text-[9px] text-neutral-400 tracking-widest uppercase font-bold">
                      {lang === 'id' ? 'TENTANG LAYANAN' : 'ABOUT SERVICE'}
                    </span>
                  </div>
                  <p className="text-neutral-600 text-sm leading-relaxed">{service.detail.about}</p>
                </motion.div>

                {/* Suitable For */}
                <motion.div variants={detailItemVariants} className="mb-6">
                  <div className="flex items-center gap-2 mb-2">
                    <Users className="w-3.5 h-3.5 text-neutral-500" />
                    <span className="font-mono text-[9px] text-neutral-400 tracking-widest uppercase font-bold">
                      {lang === 'id' ? 'COCOK UNTUK' : 'SUITABLE FOR'}
                    </span>
                  </div>
                  <div className="flex flex-wrap gap-2">
                    {service.detail.suitableFor.map((item, i) => (
                      <span key={i} className="px-3 py-1.5 bg-neutral-100 border border-neutral-200 rounded-full text-[11px] text-neutral-700 font-medium">
                        {item}
                      </span>
                    ))}
                  </div>
                </motion.div>

                {/* Work Items */}
                <motion.div variants={detailItemVariants} className="mb-6">
                  <div className="flex items-center gap-2 mb-2.5">
                    <Zap className="w-3.5 h-3.5 text-neutral-500" />
                    <span className="font-mono text-[9px] text-neutral-400 tracking-widest uppercase font-bold">
                      {lang === 'id' ? 'YANG AKAN DIKERJAKAN' : 'WHAT WILL BE DONE'}
                    </span>
                  </div>
                  <div className="flex flex-col gap-2">
                    {service.detail.workItems.map((item, i) => (
                      <div key={i} className="p-3 rounded-sm border border-neutral-100 bg-neutral-50/50">
                        <div className="flex items-start gap-3">
                          <span className="font-mono text-[10px] text-neutral-400 font-bold shrink-0 mt-0.5">
                            {String(i + 1).padStart(2, '0')}
                          </span>
                          <div>
                            <h5 className="text-black text-sm font-bold mb-0.5">{item.title}</h5>
                            <p className="text-neutral-500 text-xs leading-relaxed">{item.description}</p>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </motion.div>

                {/* Deliverables */}
                <motion.div variants={detailItemVariants} className="mb-6">
                  <div className="flex items-center gap-2 mb-2">
                    <Target className="w-3.5 h-3.5 text-neutral-500" />
                    <span className="font-mono text-[9px] text-neutral-400 tracking-widest uppercase font-bold">
                      DELIVERABLES
                    </span>
                  </div>
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
                    {service.detail.deliverables.map((item, i) => (
                      <div key={i} className="flex items-center gap-2 p-2 bg-neutral-50 border border-neutral-100 rounded-sm">
                        <CheckCircle2 className="w-3.5 h-3.5 text-black/60 shrink-0" />
                        <span className="text-neutral-700 text-xs font-medium">{item}</span>
                      </div>
                    ))}
                  </div>
                </motion.div>

                {/* Benefits */}
                <motion.div variants={detailItemVariants} className="mb-4">
                  <div className="flex items-center gap-2 mb-2.5">
                    <Zap className="w-3.5 h-3.5 text-neutral-500" />
                    <span className="font-mono text-[9px] text-neutral-400 tracking-widest uppercase font-bold">
                      {lang === 'id' ? 'MANFAAT' : 'BENEFITS'}
                    </span>
                  </div>
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    {service.detail.benefits.map((item, i) => (
                      <div key={i} className="p-3 rounded-sm border border-neutral-100 bg-neutral-50/50">
                        <h5 className="text-black text-sm font-bold mb-0.5">{item.title}</h5>
                        <p className="text-neutral-500 text-xs leading-relaxed">{item.description}</p>
                      </div>
                    ))}
                  </div>
                </motion.div>
              </motion.div>

              {/* Detail Footer — CTA */}
              <div className="px-8 py-3 border-t border-neutral-100 shrink-0">
                <button
                  onClick={() => {
                    const el = document.getElementById('contact');
                    if (el) {
                      const offset = el.getBoundingClientRect().top + window.pageYOffset - 85;
                      window.scrollTo({ top: offset, behavior: 'smooth' });
                    }
                  }}
                  className="w-full py-3 text-center bg-black hover:bg-neutral-800 text-white font-bold text-[10px] uppercase tracking-widest rounded-sm flex items-center justify-center gap-2 cursor-pointer transition-colors duration-200 active:scale-[0.98]"
                >
                  <span>{service.detail.ctaLabel}</span>
                  <ArrowRight className="w-3.5 h-3.5" />
                </button>
              </div>
            </motion.div>
          )}
        </AnimatePresence>
      </div>
    </ScrollReveal>
  );
}

// ─── Main Component (no section wrapper - wrapped in page.tsx) ───
export default function ServicesSection({ t, lang }: ServicesSectionProps) {
  return (
    <div className="relative py-24 md:py-32 bg-[#FAFAFA] overflow-hidden border-t border-neutral-200/60">
      <div className="absolute inset-0 tech-grid opacity-[0.25] pointer-events-none" />
      <div className="absolute bottom-[-100px] left-[5%] w-[350px] h-[350px] rounded-full bg-neutral-200/40 opacity-30 blur-[100px] pointer-events-none" />

      <div className="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16 md:mb-20 pb-8 border-b border-neutral-200/80">
          <div className="lg:col-span-5 flex flex-col justify-end text-left">
            <span className="font-mono text-xs tracking-[0.25em] text-neutral-400 uppercase mb-2 font-bold">02 // OPERATIONAL CAPABILITIES</span>
            <h2 className="font-sans font-black text-3xl md:text-5xl text-black tracking-tighter uppercase">
              {t.services.sectionTitle}
            </h2>
          </div>
          <div className="lg:col-span-7 flex items-end text-left">
            <p className="font-sans font-medium text-base md:text-lg text-neutral-500 tracking-tight leading-relaxed max-w-2xl">
              {t.services.subtitle}
            </p>
          </div>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
          {t.services.servicesList.map((service, idx) => (
            <ServiceCard
              key={service.id}
              service={service}
              index={idx}
              lang={lang}
              viewDetailText={t.services.viewDetail}
            />
          ))}
        </div>
      </div>
    </div>
  );
}
